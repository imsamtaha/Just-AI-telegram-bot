TELEGRAM_BOT_TOKEN=123456:replace_me
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=replace_with_current_model
BOT_SYSTEM_PROMPT=You are a concise, helpful Telegram assistant.
POLL_TIMEOUT=30
# Optional; defaults to the ATLAS dashboard URL.
ATLAS_DASHBOARD_URL=https://atlas-market.imsamtaha.chatgpt.site

# Select claude to use Anthropic instead of OpenAI (both web and Telegram).
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Durable Telegram memory and reminders; use a persistent disk/volume.
BOT_MEMORY_PATH=data/bot.sqlite3
